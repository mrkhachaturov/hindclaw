---
const gridTemplate = `"sidebar sidebar main toc toc" 1fr / minmax(min-content, 1fr) var(--fd-sidebar-col) minmax(0, calc(var(--fd-layout-width, 97rem) - var(--fd-sidebar-width) - var(--fd-toc-width))) var(--fd-toc-width) minmax(min-content, 1fr)`;

const style = [
  `grid-template: ${gridTemplate}`,
  '--fd-docs-row-1: var(--fd-banner-height, 0px)',
  '--fd-docs-row-2: calc(var(--fd-docs-row-1) + var(--fd-header-height))',
  '--fd-docs-row-3: calc(var(--fd-docs-row-2) + var(--fd-toc-popover-height))',
].join('; ');
---

<div
  id="nd-docs-layout"
  class="grid overflow-x-clip min-h-(--fd-docs-height) [--fd-docs-height:100dvh] [--fd-header-height:0px] [--fd-toc-popover-height:0px] [--fd-sidebar-width:0px] [--fd-toc-width:0px] [--fd-sidebar-col:var(--fd-sidebar-width)] transition-[grid-template-columns]"
  style={style}
>
  <slot name="sidebar" />
  <main class="[grid-area:main] min-w-0"><slot /></main>
  <slot name="toc" />
</div>
