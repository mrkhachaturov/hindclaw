---
import * as lucide from 'lucide-react';
import { cn } from '@/lib/utils';

interface Props {
  title: string;
  href?: string;
  icon?: keyof typeof lucide;
  iconClass?: string;
  external?: boolean;
  class?: string;
}

const { title, href, icon, iconClass, external, class: className } = Astro.props;

const Icon = icon ? (lucide[icon] as typeof lucide.FileText) : undefined;
const Tag = href ? 'a' : 'div';
const linkProps = href
  ? { href, ...(external ? { target: '_blank', rel: 'noreferrer noopener' } : {}) }
  : {};
---

<Tag
  data-card
  {...linkProps}
  class={cn(
    'block rounded-xl border bg-fd-card p-4 text-fd-card-foreground transition-colors @max-lg:col-span-full',
    href && 'hover:bg-fd-accent/80',
    className,
  )}
>
  {
    Icon && (
      <div class="not-prose mb-2 w-fit rounded-lg border bg-fd-muted p-1.5 text-fd-muted-foreground shadow-md [&_svg]:size-4">
        <Icon className={iconClass} />
      </div>
    )
  }
  <h3 class="not-prose mb-1 text-sm font-medium">{title}</h3>
  <div class="prose-no-margin text-sm text-fd-muted-foreground empty:hidden">
    <slot />
  </div>
</Tag>
