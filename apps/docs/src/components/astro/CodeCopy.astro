<script>
const CHECK =
  '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

function initCopy(button: HTMLButtonElement) {
  if (button.dataset.ready) return;

  const figure = button.closest('figure');
  const code = figure?.querySelector('pre');
  if (!code) return;

  button.dataset.ready = 'true';
  const clipboard = button.innerHTML;
  let timer = 0;

  button.addEventListener('click', async () => {
    const text = code.textContent ?? '';

    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.append(area);
      area.select();
      document.execCommand('copy');
      area.remove();
    }

    window.clearTimeout(timer);
    button.dataset.checked = 'true';
    button.innerHTML = CHECK;
    timer = window.setTimeout(() => {
      delete button.dataset.checked;
      button.innerHTML = clipboard;
    }, 1500);
  });
}

function initAll() {
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    'figure.shiki button[aria-label="Copy Text"]',
  )) {
    initCopy(button);
  }
}

initAll();
document.addEventListener('astro:page-load', initAll);
</script>
