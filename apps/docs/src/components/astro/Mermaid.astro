---
import { renderMermaidSVG } from 'beautiful-mermaid';

interface Props {
  chart: string;
}

const { chart } = Astro.props;

let svg: string | null = null;
try {
  svg = renderMermaidSVG(chart, {
    bg: 'var(--background)',
    fg: 'var(--foreground)',
    muted: 'var(--muted-foreground)',
    line: 'var(--border)',
    accent: 'var(--muted-foreground)',
    surface: 'var(--muted)',
    border: 'var(--border)',
    font: 'Inter Variable',
    interactive: true,
    transparent: true,
  }).replace(/\s*@import url\([^)]*\);/g, '');
} catch {
  svg = null;
}
---

{svg ? (
    <div class="fd-mermaid my-6 overflow-x-auto rounded-xl border bg-fd-card p-4" set:html={svg} />
  ) : (
    <pre class="fd-mermaid-fallback overflow-x-auto rounded-xl border p-4 text-sm">{chart}</pre>
  )}
