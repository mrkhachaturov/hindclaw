<div class="fd-tabs my-4 rounded-xl border bg-fd-card" data-tabs>
  <div class="flex flex-row items-center gap-1 overflow-x-auto border-b px-2" data-tablist></div>
  <div class="p-4"><slot /></div>
</div>

<script>
const TRIGGER_CLASS =
  'whitespace-nowrap border-b-2 border-transparent px-2 py-2 text-sm text-fd-muted-foreground data-[active=true]:border-fd-primary data-[active=true]:text-fd-primary';

function initTabs(root: HTMLElement) {
  if (root.dataset.ready) return;

  const list = root.querySelector<HTMLElement>('[data-tablist]');
  const panels = [...root.querySelectorAll<HTMLElement>('[data-tab-title]')];
  if (!list || panels.length === 0) return;

  root.dataset.ready = 'true';

  const triggers = panels.map((panel, index) => {
    const trigger = document.createElement('button');
    trigger.type = 'button';
    trigger.textContent = panel.dataset.tabTitle ?? `Tab ${index + 1}`;
    trigger.className = TRIGGER_CLASS;
    trigger.addEventListener('click', () => select(index));
    list.append(trigger);
    return trigger;
  });

  function select(active: number) {
    panels.forEach((panel, index) => {
      panel.hidden = index !== active;
    });
    triggers.forEach((trigger, index) => {
      trigger.dataset.active = String(index === active);
    });
  }

  select(0);
}

function initAll() {
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) initTabs(root);
}

initAll();
document.addEventListener('astro:page-load', initAll);
</script>
