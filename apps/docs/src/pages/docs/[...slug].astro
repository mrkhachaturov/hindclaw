---
import { render } from 'astro:content';
import { findNeighbour } from 'fumadocs-core/page-tree';
import type { TOCItemType } from 'fumadocs-core/toc';
import { DocsSidebar } from '@/components/islands/docs-sidebar';
import { DocsToc } from '@/components/islands/docs-toc';
import { mdxComponents } from '@/components/mdx';
import { PageControls } from '@/components/page-controls';
import DocsGrid from '@/layouts/DocsGrid.astro';
import DocsShell from '@/layouts/DocsShell.astro';
import { docsOgImage, docsSourceUrl } from '@/lib/site';
import { source } from '@/lib/source';

interface Props {
  slugs: string[];
}

export async function getStaticPaths() {
  return source.getPages().map((page) => ({
    params: { slug: page.slugs.length > 0 ? page.slugs.join('/') : undefined },
    props: { slugs: page.slugs },
    cacheKey: page.data._raw.digest,
  }));
}

const { slugs } = Astro.props;
const page = source.getPage(slugs);
if (!page) {
  throw new Error(`No docs page for /${slugs.join('/')}`);
}

const { Content, headings } = await render(page.data._raw);
const toc: TOCItemType[] = headings.map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: `#${heading.slug}`,
}));

const neighbours = findNeighbour(source.getPageTree(), page.url);
const { pathname } = Astro.url;
---

<DocsShell title={page.data.title} description={page.data.description} image={docsOgImage(slugs)}>
  <DocsGrid>
    <DocsSidebar
      slot="sidebar"
      tree={source.getPageTree()}
      pathname={pathname}
      params={Astro.params}
      client:load
      transition:persist
    />

    <article class="mx-auto w-full max-w-3xl px-4 py-8">
      <div class="flex flex-col gap-2 border-b pb-6">
        <div class="flex items-center justify-between gap-4 md:items-start">
          <h1 class="text-3xl font-semibold tracking-tight">{page.data.title}</h1>
          <PageControls
            pathname={pathname}
            previous={neighbours.previous}
            next={neighbours.next}
            markdownUrl={`${page.url}.mdx`}
            githubUrl={docsSourceUrl(page.path)}
            client:idle
          />
        </div>
        {page.data.description && (
          <p class="text-lg text-fd-muted-foreground sm:text-balance md:max-w-[80%]">
            {page.data.description}
          </p>
        )}
      </div>

      <div class="prose prose-gray dark:prose-invert mt-8">
        <Content components={mdxComponents} />
      </div>
    </article>

    <DocsToc
      slot="toc"
      toc={toc}
      pathname={pathname}
      title={page.data.title}
      markdownUrl={`${page.url}.mdx`}
      githubUrl={docsSourceUrl(page.path)}
      client:idle
    />
  </DocsGrid>
</DocsShell>
