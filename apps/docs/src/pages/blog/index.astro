---
import Site from '@/layouts/Site.astro';
import { blogLoader } from '@/lib/blog';

const posts = blogLoader.getPages().sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Site title="Blog" description="Release notes and writing about HindClaw.">
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-semibold tracking-tight">Blog</h1>

    <div class="mt-10 flex flex-col gap-8">
      {posts.map((post) => (
          <article class="border-b border-fd-border pb-8 last:border-0">
            <time datetime={post.data.date.toISOString()} class="text-sm text-fd-muted-foreground">
              {post.data.date.toLocaleDateString('en', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            <h2 class="mt-2 text-xl font-medium">
              <a href={post.url} class="hover:underline">
                {post.data.title}
              </a>
            </h2>
            {post.data.description && (
              <p class="mt-2 text-fd-muted-foreground">{post.data.description}</p>
            )}
          </article>
        ))}
    </div>
  </div>
</Site>
