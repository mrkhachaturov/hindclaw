---
import { render } from 'astro:content';
import { findNeighbour } from 'fumadocs-core/page-tree';
import { mdxComponents } from '@/components/mdx';
import Site from '@/layouts/Site.astro';
import { blogLoader } from '@/lib/blog';

export async function getStaticPaths() {
  return blogLoader.getPages().map((page) => ({
    params: { slug: page.slugs.join('/') },
    props: { slugs: page.slugs },
    cacheKey: page.data._raw.digest,
  }));
}

const { slugs } = Astro.props;
const page = blogLoader.getPage(slugs);
if (!page) {
  throw new Error(`No blog post for /${slugs.join('/')}`);
}

const { Content } = await render(page.data._raw);
const neighbours = findNeighbour(blogLoader.getPageTree(), page.url);
---

<Site title={page.data.title} description={page.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-16">
    <div class="flex flex-row gap-6 text-sm">
      {page.data.author && (
          <div>
            <p class="mb-1 text-fd-muted-foreground">Written by</p>
            <p class="font-medium">{page.data.author}</p>
          </div>
        )}
      <div>
        <p class="mb-1 text-fd-muted-foreground">At</p>
        <p class="font-medium">
          {page.data.date.toLocaleDateString('en', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
        </p>
      </div>
    </div>

    <h1 class="mt-8 text-3xl font-semibold tracking-tight">{page.data.title}</h1>
    {page.data.description && <p class="mt-3 text-fd-muted-foreground">{page.data.description}</p>}

    <div class="prose mt-8">
      <Content components={mdxComponents} />
    </div>

    <nav class="mt-12 flex justify-between gap-4 border-t border-fd-border pt-6 text-sm">
      {neighbours.previous ? (
          <a href={neighbours.previous.url} class="text-fd-muted-foreground hover:text-fd-foreground">
            ← {neighbours.previous.name}
          </a>
        ) : (
          <span />
        )}
      {neighbours.next && (
          <a href={neighbours.next.url} class="text-fd-muted-foreground hover:text-fd-foreground">
            {neighbours.next.name} →
          </a>
        )}
    </nav>
  </article>
</Site>
